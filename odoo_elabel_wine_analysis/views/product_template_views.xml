<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_wine_analysis" model="ir.ui.view">
        <field name="name">product.template.form.elabel.wine.analysis</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="odoo_elabel.product_template_form_elabel"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='elabel_ingredients']/ancestor::group[1]" position="before">
                <group string="Weinanalytik – Shop und Website">
                    <field name="elabel_acidity_g_l"/>
                    <field name="elabel_residual_sugar_g_l"/>
                    <field name="elabel_alcohol_percent"/>
                    <div class="text-muted" colspan="2">Angaben erscheinen nach erneuter Freigabe im Shop-/Snippet-Block. Nullwerte werden dort ausgeblendet. Die separate e-Label-Seite und PDFs bleiben unverändert.</div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
