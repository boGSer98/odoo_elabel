<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template
        id="website_sale_product_elabel_button"
        inherit_id="website_sale.product"
        priority="20"
        name="Website Sale e-Label Button"
    >
        <xpath expr="//t[@t-call='website_sale.cta_wrapper']" position="after">
            <div t-if="product._get_website_elabel_summary(website)" class="o_elabel_standalone_button mt-2">
            <a

                class="btn btn-outline-secondary flex-grow-1 flex-lg-grow-0"
                t-att-href="product._get_elabel_public_route()"
                target="_blank"
                rel="noopener noreferrer"
            >
                View e-Label
            </a>
            </div>
        </xpath>
    </template>
    <template id="website_sale_elabel_summary" name="Website Sale e-Label Summary">
            <section t-if="elabel_summary" class="o_elabel_product_summary border rounded p-3 mt-3 mb-3 small"
                     aria-label="Ingredients and nutrition">
                <h6 class="mb-2">Ingredients and nutrition</h6>
                <table t-if="elabel_summary['ingredients'] or elabel_summary['allergens'] or elabel_summary['additional_substances'] or elabel_summary['analysis_lines']"
                       class="o_elabel_details table table-sm table-borderless mb-2"
                       style="table-layout: fixed;">
                    <colgroup><col style="width: 45%;"/><col style="width: 55%;"/></colgroup>
                    <tbody>
                        <tr t-if="elabel_summary['ingredients']">
                            <th scope="row" class="fw-semibold align-top pt-0 pb-1 ps-0 pe-2" style="overflow-wrap: anywhere;"><t t-out="elabel_summary['labels']['ingredients']"/>:</th>
                            <td class="align-top text-start pt-0 pb-1 pe-0" style="white-space: pre-wrap; overflow-wrap: anywhere;" t-out="elabel_summary['ingredients']"/>
                        </tr>
                        <tr t-if="elabel_summary['allergens']">
                            <th scope="row" class="fw-semibold align-top pt-0 pb-1 ps-0 pe-2" style="overflow-wrap: anywhere;"><t t-out="elabel_summary['labels']['allergens']"/>:</th>
                            <td class="align-top text-start pt-0 pb-1 pe-0" style="white-space: pre-wrap; overflow-wrap: anywhere;" t-out="elabel_summary['allergens']"/>
                        </tr>
                        <tr t-if="elabel_summary['additional_substances']">
                            <th scope="row" class="fw-semibold align-top pt-0 pb-1 ps-0 pe-2" style="overflow-wrap: anywhere;"><t t-out="elabel_summary['labels']['additional_substances']"/>:</th>
                            <td class="align-top text-start pt-0 pb-1 pe-0" style="white-space: pre-wrap; overflow-wrap: anywhere;" t-out="elabel_summary['additional_substances']"/>
                        </tr>
                    </tbody>
                    <tbody t-if="elabel_summary['analysis_lines']" class="o_elabel_analysis">
                        <tr t-foreach="elabel_summary['analysis_lines']" t-as="line">
                            <th scope="row" class="fw-semibold align-top pt-0 pb-1 ps-0 pe-2" style="overflow-wrap: anywhere;"><t t-out="line['label']"/>:</th>
                            <td class="align-top text-start pt-0 pb-1 pe-0" style="white-space: pre-wrap; overflow-wrap: anywhere;" t-out="line['value']"/>
                        </tr>
                    </tbody>
                </table>
                <p t-if="elabel_summary['nutrition_lines']" class="fw-semibold mt-2 mb-1" t-out="elabel_summary['labels']['information_per_100_ml']"/>
                <table t-if="elabel_summary['nutrition_lines']" class="o_elabel_nutrition table table-sm table-borderless mb-0 small">
                    <tbody>
                        <tr t-foreach="elabel_summary['nutrition_lines']" t-as="line">
                            <th scope="row" class="fw-normal py-1 ps-0" t-out="line['label']"/>
                            <td class="py-1 pe-0 text-end" t-out="line['value']"/>
                        </tr>
                    </tbody>
                </table>
                <p t-if="elabel_summary['nutrition_note']" class="text-muted mt-1 mb-0" t-out="elabel_summary['nutrition_note']"/>
            </section>
    </template>
    <template id="website_sale_product_elabel_contents" inherit_id="website_sale.product"
              name="Website Sale e-Label Contents">
        <xpath expr="//t[@t-call='website_sale.cta_wrapper']" position="after">
            <t t-set="elabel_summary" t-value="product._get_website_elabel_summary(website)"/>
            <t t-call="odoo_elabel_sale.website_sale_elabel_summary"/>
        </xpath>
    </template>
</odoo>
