<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="privilege_elabel" model="res.groups.privilege"><field name="name">E-Label</field><field name="category_id" ref="base.module_category_inventory"/></record>
 <record id="group_elabel_editor" model="res.groups"><field name="name">Bearbeiter</field><field name="privilege_id" ref="privilege_elabel"/><field name="implied_ids" eval="[(4,ref('base.group_user'))]"/></record>
 <record id="group_elabel_reviewer" model="res.groups"><field name="name">Freigabe</field><field name="privilege_id" ref="privilege_elabel"/><field name="implied_ids" eval="[(4,ref('group_elabel_editor'))]"/></record>
 <record id="revision_company_rule" model="ir.rule"><field name="name">e-Label: Unternehmensgrenzen</field><field name="model_id" ref="model_wine_elabel_revision"/><field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field></record>
 <record id="managed_attachment_company_role_guard" model="ir.rule"><field name="name">e-Label-Dateien: Rolle und Firmenkontext</field><field name="model_id" ref="base.model_ir_attachment"/><field name="domain_force">['|', ('elabel_revision_id', '=', False), '|', ('elabel_revision_id.company_id', '=', False), ('elabel_revision_id.company_id', 'in', company_ids)] if (user.has_group('odoo_elabel.group_elabel_editor') or user.has_group('base.group_system')) else [('elabel_revision_id', '=', False)]</field></record>
</odoo>
