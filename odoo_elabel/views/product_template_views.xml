<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="product_template_form_elabel" model="ir.ui.view">
  <field name="name">product.template.form.elabel</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/>
  <field name="arch" type="xml"><xpath expr="//form/sheet/notebook" position="inside">
   <page string="E-Label">
    <field name="elabel_state" widget="statusbar"/><group><field name="elabel_enabled"/><field name="elabel_public_url" widget="url"/><field name="elabel_current_revision_id" options="{'no_create':True}"/></group>
    <div class="alert alert-warning" invisible="not elabel_pending_changes">Es gibt unveröffentlichte Änderungen. Der öffentliche QR-Link zeigt weiterhin die letzte freigegebene Fassung.</div>
    <div class="alert alert-info" invisible="not elabel_documents_stale">Dokumente fehlen, gehören zu einer älteren Veröffentlichung oder es liegen noch unveröffentlichte Änderungen vor.</div>
    <field name="elabel_pending_changes" invisible="1"/><field name="elabel_documents_stale" invisible="1"/>
    <div class="d-flex flex-wrap gap-2 mb-3">
     <button name="action_submit_elabel" string="Zur Prüfung einreichen" type="object" groups="odoo_elabel.group_elabel_editor,base.group_system"/>
     <button name="action_publish_elabel" string="Fassung veröffentlichen" type="object" groups="odoo_elabel.group_elabel_reviewer,base.group_system" confirm="Aktuelle Fassung veröffentlichen? Nährwerthinweise verhindern die Freigabe nicht."/>
     <button name="action_generate_elabel_documents" string="PDF und QR-SVG speichern" type="object" groups="odoo_elabel.group_elabel_editor,base.group_system"/>
     <button name="action_view_elabel_url" string="Öffentliche Fassung ansehen" type="object" invisible="not elabel_current_revision_id"/>
     <button name="action_disable_elabel" string="Öffentliche Ausgabe sperren" type="object" groups="odoo_elabel.group_elabel_reviewer,base.group_system" invisible="not elabel_enabled" confirm="Gedruckte QR-Links zeigen bis zur erneuten Freigabe keine Labelinformationen. Wirklich sperren?"/>
    </div>
    <div class="alert alert-warning" role="alert" invisible="not elabel_nutrition_warning"><strong>Nährwerthinweis – Freigabe weiterhin möglich</strong><field name="elabel_nutrition_warning" nolabel="1" readonly="1"/></div>
    <group string="Nährwerte je 100 ml"><group><field name="elabel_energy_kj"/><field name="elabel_energy_kcal"/><field name="elabel_fat"/><field name="elabel_saturates"/></group><group><field name="elabel_carbohydrate"/><field name="elabel_sugars"/><field name="elabel_protein"/><field name="elabel_salt"/></group></group>
    <group string="Inhaltsstoffe"><field name="elabel_ingredients"/><field name="elabel_allergen_statement"/><field name="elabel_additional_substances"/><field name="elabel_nutrition_note"/></group>
    <group string="Datengrundlage und Sprachen"><field name="elabel_nutrition_confirmed"/><field name="elabel_allergens_confirmed"/><field name="elabel_source"/><field name="elabel_checked_on"/><field name="elabel_language_ids" widget="many2many_tags"/></group>
    <field name="elabel_revision_ids" readonly="1"><list create="0" delete="0"><field name="number"/><field name="name"/><field name="create_date"/><field name="create_uid"/><field name="legacy"/></list></field>
   </page>
  </xpath></field>
 </record>
 <record id="elabel_company_form" model="ir.ui.view"><field name="name">elabel.company.form</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="E-Label"><field name="elabel_base_url"/></group></xpath></field></record>
 <record id="elabel_adoption_form" model="ir.ui.view"><field name="name">elabel.adoption.form</field><field name="model">wine.elabel.adoption</field><field name="arch" type="xml"><form string="Vorhandene Labeldateien geprüft zuordnen"><div class="alert alert-warning">Nur ausdrücklich geprüfte Altdateien auswählen. Öffentliche Dateifreigaben werden geschlossen. Ungewählte Anhänge werden weder verschoben noch gelöscht.</div><group><field name="product_id"/><field name="lang_id"/><field name="attachment_ids" widget="many2many_tags"/><field name="confirmed"/></group><footer><button name="action_adopt" type="object" string="Geprüft übernehmen" class="btn-primary"/><button special="cancel" string="Abbrechen"/></footer></form></field></record>
 <record id="elabel_adoption_action" model="ir.actions.act_window"><field name="name">E-Label-Bestandsdateien prüfen</field><field name="res_model">wine.elabel.adoption</field><field name="view_mode">form</field><field name="target">new</field></record>
 <!-- Explicit action reset is required when upgrading the legacy root menu. -->
 <record id="menu_elabel_root" model="ir.ui.menu">
  <field name="name">E-Label</field>
  <field name="sequence">90</field>
  <field name="group_ids" eval="[(6, 0, [ref('odoo_elabel.group_elabel_editor'), ref('base.group_system')])]"/>
  <field name="action" eval="False"/>
 </record>
 <menuitem id="elabel_adoption_menu" name="Bestandsdateien prüfen" parent="menu_elabel_root" action="elabel_adoption_action" groups="odoo_elabel.group_elabel_reviewer,base.group_system" sequence="95"/>
</odoo>
