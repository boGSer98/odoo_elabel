<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_elabel_products" model="ir.actions.act_window">
        <field name="name">eLabel</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("elabel_enabled", "=", True)]</field>
        <field name="context">{"default_elabel_enabled": True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                eLabel-Produkte verwalten
            </p>
            <p>
                Öffne Produkte mit aktivem Wine e-Label oder lege neue Produktdaten für QR-Code und Rechtstext-Ausgabe an.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_elabel_root"
        name="eLabel"
        action="action_elabel_products"
        sequence="55"
        web_icon="odoo_elabel,static/description/icon.png"
    />
</odoo>
