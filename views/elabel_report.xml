<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_wine_elabel_pdf_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="product">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <h2>
                            <t t-esc="product.display_name"/> - Wine e-Label
                        </h2>

                        <t t-set="is_pdf" t-value="True"/>
                        <t t-call="odoo_elabel.wine_elabel_information"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_wine_elabel_pdf" model="ir.actions.report">
        <field name="name">Wine e-Label PDF</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_elabel.report_wine_elabel_pdf_document</field>
        <field name="report_file">odoo_elabel.report_wine_elabel_pdf_document</field>
        <field name="print_report_name">'wine_elabel_%s' % (object.default_code or object.id)</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
